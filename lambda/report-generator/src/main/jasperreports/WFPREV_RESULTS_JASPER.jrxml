			<text><![CDATA[Put shape file in associated district folder on the
SharePoint. The shape file associated with <style isBold="true">ONLY</style> the
treated area is to be attached, not opening spatial. BC
Albers Projection Name convention: ProjectID_Opening or
ProjectID_ActivityDescription]]></text>
			<box>
				<topPen lineWidth="1.0" lineColor="#000000" />
				<leftPen lineWidth="1.0" lineColor="#000000" />
				<bottomPen lineWidth="0.0" lineColor="#000000" />
				<rightPen lineWidth="1.0" lineColor="#000000" />
			</box>
		</element>
		<element kind="staticText" uuid="68130698-dc7e-5f73-8a98-b047bbe2c1b5" mode="Opaque" x="4813" y="86" width="286" height="136" backcolor="#C6E0B4" fontName="Calibri" fontSize="10.0" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[Type in shape file name and put shape file in associated
district folder on the SharePoint. This is for the entire gross
opening area, but can include multiple polygons. BC Albers
Projection Name convention: ProjectID_Opening or
ProjectID_ActivityDescription]]></text>
			<box>
				<topPen lineWidth="1.0" lineColor="#000000" />
				<leftPen lineWidth="1.0" lineColor="#000000" />
				<bottomPen lineWidth="0.0" lineColor="#000000" />
				<rightPen lineWidth="1.0" lineColor="#000000" />
			</box>
		</element>
		<element kind="staticText" uuid="e491a752-38db-5b01-ae0b-c24193e3f125" mode="Opaque" x="5099" y="86" width="249" height="136" backcolor="#C6E0B4" fontName="Calibri" fontSize="10.0" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[Forest Cover Attributes must be included on a
separate document placed on the associated
district folder on the SharePoint, the forest cover
survey can be attached, or a separate document
that includes all the required forest cover attributes
for all forest cover polygons. Attached? (Y/N)]]></text>
			<box>
				<topPen lineWidth="1.0" lineColor="#000000" />
				<leftPen lineWidth="1.0" lineColor="#000000" />
				<bottomPen lineWidth="0.0" lineColor="#000000" />
				<rightPen lineWidth="1.0" lineColor="#000000" />
			</box>
		</element>
		<element kind="staticText" uuid="5056f4a8-d0f1-576a-8dfb-90a6e69abf61" mode="Opaque" x="5348" y="86" width="158" height="136" backcolor="#C6E0B4" fontName="Calibri" fontSize="10.0" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[If the project activities include
Survey or Land-Base Planning,
please attached the prescription
within the associated district
folder on the SharePoint.
Attached? (Y/N)]]></text>
			<box>
				<topPen lineWidth="1.0" lineColor="#000000" />
				<leftPen lineWidth="1.0" lineColor="#000000" />
				<bottomPen lineWidth="0.0" lineColor="#000000" />
				<rightPen lineWidth="1.0" lineColor="#000000" />
			</box>
		</element>
